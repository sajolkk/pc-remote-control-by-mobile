<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up or moved to a new phone. The pairing data is encrypted with a key held in
  this phone's Android Keystore, which is never backed up: restored without it, the data cannot
  be read, and the app would fail on every launch. Pairing a new phone is the intended path.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
