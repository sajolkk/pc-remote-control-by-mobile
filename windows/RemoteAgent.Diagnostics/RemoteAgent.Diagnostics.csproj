<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Structured logging shared by every host.

    Exists so the redaction rules in §7.5 are written once and applied identically by the service,
    the session agent and the UI. A copy per host is how one of them quietly starts logging
    clipboard contents.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RemoteAgent.Diagnostics</RootNamespace>
    <AssemblyName>RemoteAgent.Diagnostics</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteAgent.Core\RemoteAgent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
  </ItemGroup>

</Project>
