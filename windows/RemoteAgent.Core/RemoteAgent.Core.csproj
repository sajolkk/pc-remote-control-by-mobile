<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Domain logic, abstractions and the command pipeline.

    Deliberately platform-neutral: no Win32, no WinRT, no COM (architecture doc
    §13 rule 1). That is what lets the authorization gate, the dispatcher and the
    validators be unit tested without a desktop, a service host, or a GPU.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RemoteAgent.Core</RootNamespace>
    <AssemblyName>RemoteAgent.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteAgent.Protocol\RemoteAgent.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(MicrosoftExtensionsVersion)" />
  </ItemGroup>

</Project>
