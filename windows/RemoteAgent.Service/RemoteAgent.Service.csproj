<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The privileged host: LocalSystem, Session 0, always running.

    Published self-contained and single-file so a target PC needs no .NET runtime
    installed, for both x64 and ARM64 (§0).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <SupportedOSPlatformVersion>$(WindowsPlatformFloor)</SupportedOSPlatformVersion>
    <RootNamespace>RemoteAgent.Service</RootNamespace>
    <AssemblyName>RemoteAgent.Service</AssemblyName>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteAgent.Core\RemoteAgent.Core.csproj" />
    <ProjectReference Include="..\RemoteAgent.Protocol\RemoteAgent.Protocol.csproj" />
    <ProjectReference Include="..\RemoteAgent.Security\RemoteAgent.Security.csproj" />
    <ProjectReference Include="..\RemoteAgent.Windows\RemoteAgent.Windows.csproj" />
    <ProjectReference Include="..\RemoteAgent.Ipc\RemoteAgent.Ipc.csproj" />
    <ProjectReference Include="..\RemoteAgent.Diagnostics\RemoteAgent.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="$(MicrosoftExtensionsVersion)" />
    <!-- Range attributes on the options classes are enforced at startup, so a bad config value
         fails loudly at launch rather than silently at the first request. -->
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
  </ItemGroup>

</Project>
