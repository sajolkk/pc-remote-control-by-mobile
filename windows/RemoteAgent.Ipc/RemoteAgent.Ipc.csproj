<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Named-pipe IPC between the SYSTEM service and the user-session agent.

    Targets net10.0-windows because pipe ACLs are a Windows concept, but contains no
    P/Invoke: everything is expressed through System.IO.Pipes and the framing already
    defined in Protocol, so the wire format is shared with the network layer and tested
    once.
  -->

  <PropertyGroup>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <SupportedOSPlatformVersion>$(WindowsPlatformFloor)</SupportedOSPlatformVersion>
    <RootNamespace>RemoteAgent.Ipc</RootNamespace>
    <AssemblyName>RemoteAgent.Ipc</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteAgent.Core\RemoteAgent.Core.csproj" />
    <ProjectReference Include="..\RemoteAgent.Protocol\RemoteAgent.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
  </ItemGroup>

</Project>
